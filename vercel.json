{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "anti-clone.js", "use": "@vercel/static" },
    { "src": "bypass-sfl/index.html", "use": "@vercel/static" },
    { "src": "bypass-sfl/assets/*", "use": "@vercel/static" },
    { "src": "bypass-sfl/api/bypass.js", "use": "@vercel/node" }
  ],
  "rewrites": [
    { "source": "/bypass-sfl/api/bypass", "destination": "/bypass-sfl/api/bypass.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/bypass-sfl/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
